    "frequented": { "r_min": 150, "r_max": 700,  "tau_hours": 7200, "i_min": 0.50, "i_max": 0.85 },
    "traveled":   { "r_min": 150, "r_max": 500,  "tau_hours": 48,   "i_min": 0.35, "i_max": 0.65 },
    "visited":    { "r_min": 80,  "r_max": 350,  "tau_hours": 4320, "i_min": 0.45, "i_max": 0.78 },
    "guest":      { "r_min": 40,  "r_max": 120,  "tau_hours": 6,    "i_min": 0.30, "i_max": 0.48 }
  },

  "category_color": {
